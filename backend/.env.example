# Default: a local SQLite file (no install needed).
DATABASE_URL=sqlite:///./stocktrade.db

# MySQL instead (create the database first: CREATE DATABASE stocktrade;)
# Also uncomment pymysql and cryptography in requirements.txt and run pip install again.
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/stocktrade

# PostgreSQL instead (also uncomment psycopg2-binary in requirements.txt):
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/stocktrade

JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
